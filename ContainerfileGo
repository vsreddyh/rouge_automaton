# Rouge Automaton (Go) — static binary, distroless runtime.
# Build behind host networking (rootless Podman has no DNS on the default
# build network): podman build --network=host -f ContainerfileGo .
FROM docker.io/library/golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY souldata.go ./
COPY skills ./skills
RUN CGO_ENABLED=0 go build -o /rouge ./cmd/rouge && \
    CGO_ENABLED=0 go build -o /ingest ./cmd/ingest && \
    CGO_ENABLED=0 go build -o /watch ./cmd/watch && \
    CGO_ENABLED=0 go build -o /mcpdb ./cmd/mcpdb

FROM gcr.io/distroless/static-debian12:nonroot
# Root-owned 0644 files are readable by nonroot; /app is created by COPY.
# /mcpdb is the MCP server (stdio); run it explicitly, e.g.
# podman run -i --network=host -e MONGO_URI=... <image> /mcpdb
COPY --from=build /rouge /ingest /watch /mcpdb /
COPY skills/ /app/skills/
WORKDIR /app
ENTRYPOINT ["/rouge"]
