# Rouge Automaton creds — never commit the filled file.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs, e.g. 111111111111111111,222222222222222222.
# Empty + ALLOW_ALL_USERS=false below means nobody may use the bot.
DISCORD_ALLOWED_USERS=
DISCORD_ALLOW_ALL_USERS=false
# Comma-separated channel IDs that get replies without a mention.
# Each entry multiplies model calls — keep this list short.
DISCORD_FREE_RESPONSE_CHANNELS=1547681840628764854
# Model key (Muse Spark 1.3 Contributor via OpenCode Go relay, key from opencode.ai):
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go
MODEL=muse-spark-1.3-contributor
MONGO_URI=mongodb://mongo:27017/rouge
X_SUPER_CLIENT=rouge-automaton
X_SUPER_CONTACT=admin@example.com
